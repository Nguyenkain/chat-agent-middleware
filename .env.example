PORT=3000

# Chatwoot
CHATWOOT_BASE_URL=https://your-chatwoot.com
CHATWOOT_API_TOKEN=your_agent_bot_token
CHATWOOT_ACCOUNT_ID=1
CHATWOOT_WEBHOOK_SECRET=your_webhook_hmac_secret

# Dify
DIFY_BASE_URL=https://api.dify.ai/v1
DIFY_API_KEY=your_dify_app_api_key
# app-xxx nếu dùng Chatflow, workflow-xxx nếu dùng Workflow
DIFY_APP_TYPE=chatflow

# Worker
WORKER_POLL_INTERVAL_MS=5000
JOB_MAX_ATTEMPTS=3
